# Ключи — создай файлы локально, на Render задай в Environment
DATABASE_URL=postgresql://user:pass@host/db   # бесплатная Postgres: neon.tech
MISTRAL_API_KEY=...                            # console.mistral.ai — модель mistral-small-latest
AZURE_SPEECH_KEY=...                           # portal.azure.com → Speech Service (Free tier F0)
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_VOICE=ru-RU-SvetlanaNeural
SESSION_SECRET=any-random-string
