# Ключи — локально в .env, на Render — в Environment
DATABASE_URL=postgresql://user:pass@host/db   # бесплатная Postgres: neon.tech
MISTRAL_API_KEY=...                            # console.mistral.ai
MISTRAL_MODEL=ministral-14b-latest

# Azure Speech: распознавание речи ru-RU + kk-KZ, запасная озвучка
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=ru-RU-SvetlanaNeural
AZURE_SPEECH_VOICE_KK=kk-KZ-AigulNeural

# Fish Audio: основная озвучка, женский голос, бесплатная модель s2.1-pro-free
# Ключ: fish.audio → API Keys. Голоса: каталог fish.audio → открыть голос → ID из URL /m/<id>
FISH_API_KEY=...
FISH_MODEL=s2.1-pro-free
FISH_VOICE_RU=e3ca0b027dc349539885834f450e35eb
FISH_VOICE_KK=e3ca0b027dc349539885834f450e35eb

# Создатель (админ дэшборда учителей)
ADMIN_LOGIN=pyfold
ADMIN_PASSWORD=Hopedeke_725280

SESSION_SECRET=any-random-string
