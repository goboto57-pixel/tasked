# Ключи — локально в .env, на Render — в Environment
DATABASE_URL=postgresql://user:pass@host/db   # бесплатная Postgres: neon.tech
MISTRAL_API_KEY=...                           # console.mistral.ai/api-keys
MISTRAL_MODEL=ministral-14b-latest
MISTRAL_FALLBACK_MODEL=ministral-14b-latest

# Azure Speech: распознавание речи ru-RU + kk-KZ, запасная озвучка
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=ru-RU-SvetlanaNeural
AZURE_SPEECH_VOICE_KK=kk-KZ-AigulNeural

# Fish Audio: основная озвучка. Спокойный женский голос RU + двуязычный женский RU/KK.
# Ключ: fish.audio → API Keys. Голоса: каталог fish.audio → открыть голос → ID из URL /m/<id>
FISH_API_KEY=...
FISH_MODEL=s2.1-pro-free
FISH_VOICE_RU=e897cbd38bc94548b7f5340c9db5fc4d
FISH_VOICE_KK=93bb57166f474f43bdbdadec4c20298f

# Firebase Authentication: Google sign-in + verified email codes through Brevo.
# Client values are available in Firebase project settings; keep service account JSON private.
FIREBASE_API_KEY=...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=...
FIREBASE_SERVICE_ACCOUNT=...                 # Firebase Admin service-account JSON; server only

# Brevo transactional email: verify a sender address in Brevo before using it.
BREVO_API_KEY=...
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=Tasked

# Создатель (админ дэшборда учителей)
ADMIN_LOGIN=pyfold
ADMIN_PASSWORD=...                           # required only for legacy teacher/admin dashboard

SESSION_SECRET=any-random-string
